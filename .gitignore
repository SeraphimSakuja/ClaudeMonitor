.DS_Store

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Ausnahme: Das App-Projekt löst Sparkle als Remote-SPM-Paket auf. Diese
# Package.resolved MUSS versioniert werden, sonst ist die Version des
# Update-Frameworks ungepinnt und `upToNextMinorVersion` könnte beim nächsten
# `xcodebuild` unbemerkt eine andere 2.x-Version ziehen — ein fremdes
# Framework, das Code auf Nutzermaschinen installiert.
!App/ClaudeMonitor.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
build/

# Lokale Konfigurations-Overrides. Die Team-ID selbst steht in
# App/Signing.xcconfig und ist kein Geheimnis — sie steckt in jeder
# ausgelieferten App-Signatur.
*.local.xcconfig
