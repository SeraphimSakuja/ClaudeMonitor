<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bewusst NICHT sandboxed: Die App liest ~/.claude-swap-backup/… -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Brücke zur (sandboxed) Widget-Extension. App Groups funktionieren auf
	     macOS auch ohne Sandbox. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.at.markusfricke.claudemonitor.shared</string>
	</array>
</dict>
</plist>
