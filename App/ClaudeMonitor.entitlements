<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bewusst NICHT sandboxed: Die App liest ~/.claude-swap-backup/… -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- KEIN com.apple.security.application-groups.

	     Die App Group ist allein die Brücke zur WidgetKit-Extension, und die
	     liegt auf Hold. Ein hier eingetragenes, aber nicht autorisiertes
	     Entitlement wäre der gefährlichste Zustand überhaupt: Die Wache in
	     AppGroupEntitlement.swift prüft die Deklaration, nicht die
	     Autorisierung — sie gäbe den Container frei, und der Zugriff bliebe im
	     macOS-Zustimmungsdialog endlos hängen. Begründung und die fünf
	     Schritte für die Rückkehr der Widgets stehen in App/Signing.xcconfig. -->
</dict>
</plist>
