// Signierung von ClaudeMonitor.
//
// Ausgeliefert wird als **Developer ID**, notarisiert, mit Hardened Runtime
// (`ENABLE_HARDENED_RUNTIME = YES` steht im Projekt). Das ist der Weg für eine
// App, die außerhalb des App Store verteilt wird: Ohne Notarisierung blockt
// Gatekeeper sie, und seit macOS 15 gibt es den Rechtsklick-Umweg nicht mehr —
// der Nutzer müsste sie in den Systemeinstellungen freischalten.
//
// KEIN Provisioning-Profil, und das ist Absicht:
//
//   Ein Developer-ID-Build braucht nur dann ein Profil, wenn er ein
//   eingeschränktes Entitlement führt (App Groups, iCloud, Push …). Diese App
//   führt keins — sie ist nicht sandboxed und liest ausschließlich unterhalb
//   des eigenen Home-Verzeichnisses (`~/.claude-swap-backup/…`), ein Ort, der
//   nicht TCC-geschützt ist. Damit entfallen Profil UND die Registrierung im
//   Developer-Portal vollständig.
//
// ---------------------------------------------------------------------------
// WARUM DAS APP-GROUP-ENTITLEMENT HIER NICHT GESETZT IST
//
// Die App Group ist ausschließlich die Brücke zur WidgetKit-Extension, und die
// liegt auf Hold. Sie jetzt zu aktivieren würde erzwingen:
//
//   * `AppGroup.identifier` auf `<TeamID>.group.…` umzustellen (auf macOS MUSS
//     die Kennung mit der Team-ID beginnen) — das ist zugleich der Vertrag mit
//     der Extension und müsste beim Widget-Bau ohnehin erneut angefasst werden,
//   * die Gruppe im Developer-Portal zu registrieren und an der App-ID zu
//     aktivieren,
//   * ein Provisioning-Profil einzubetten.
//
// ⚠️ GEFAHR, falls jemand das Entitlement „schon mal vorsorglich" einträgt:
//    Deklariert, aber nicht autorisiert ist der schlimmste Zustand. Die Wache
//    in Shared/Sources/ClaudeMonitorShared/AppGroupEntitlement.swift prüft die
//    DEKLARATION, nicht die Autorisierung — sie meldet `isDeclared() == true`
//    und gibt den Container frei. Der Zugriff läuft dann in den macOS-Dialog
//    „Zugriff auf Daten anderer Apps", und ohne sichtbares Fenster blockiert er
//    ENDLOS (zweimal reproduziert). Entweder beides oder keins von beidem.
//
// Der aktuelle Zustand ist der sichere: Die Wache meldet „nicht deklariert",
// `SnapshotStore.write` gibt `containerUnavailable` zurück, ohne den Container
// je anzufassen, und die Menüleiste läuft unverändert. Der gesamte
// App-Group-Code bleibt für die Rückkehr der Widgets erhalten.
//
// SOBALD DIE WIDGETS ZURÜCKKOMMEN, sind es diese fünf Schritte:
//   1) `CLAUDEMONITOR_ENTITLEMENTS` zeigt bereits auf die Datei — dort
//      `com.apple.security.application-groups` mit `<TeamID>.group.…` ergänzen.
//   2) `AppGroup.identifier` auf denselben, team-präfixierten Wert setzen.
//   3) App Group im Developer-Portal registrieren und an der App-ID
//      `at.markusfricke.claudemonitor` aktivieren.
//   4) Profil erzeugen lassen und `PROVISIONING_PROFILE_SPECIFIER` setzen.
//   5) Gegenprobe: `codesign -d --entitlements - <Pfad zur .app>` muss die
//      Gruppe zeigen, und im Log muss „Snapshot in den App-Group-Container
//      geschrieben" erscheinen. Steht dort `containerUnavailable`, ist einer
//      der Schritte offen.
//    Alle drei Stellen (AppGroup.swift, .entitlements, Portal) müssen
//    ZEICHENGLEICH sein.
// ---------------------------------------------------------------------------

CLAUDEMONITOR_TEAM = 94794Q4RW7
CLAUDEMONITOR_ENTITLEMENTS = ClaudeMonitor.entitlements

// Manual + explizite Identität: Der Developer-ID-Build soll reproduzierbar
// dieselbe Signatur tragen. Sparkle verweigert später einen Wechsel auf eine
// Version, deren Signatur nicht zur installierten passt — die Identität darf
// sich ab v1.0 nicht mehr ändern.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
PROVISIONING_PROFILE_SPECIFIER =

// Sichere Zeitstempel: Ohne sie läuft die Signatur mit dem Zertifikat ab,
// statt über dessen Gültigkeit hinaus gültig zu bleiben. Notarisierung
// verlangt sie ohnehin.
OTHER_CODE_SIGN_FLAGS = $(inherited) --timestamp
